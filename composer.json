{
    "name": "skydropx/plugin-magento",
    "description": "Build and lint tooling for the Skydropx_Shipping Magento 2 module",
    "type": "project",
    "license": "proprietary",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "magento/magento-coding-standard": "^41",
        "phpcompatibility/php-compatibility": "*"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    }
}
